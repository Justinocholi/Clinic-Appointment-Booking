# Koya Clinic Appointment Booking API Environment Variables

# The secret API key required in the X-API-Key header (Level 2)
API_KEY=koya-assessment-api-key-secret

# Supabase PostgreSQL connection string (Transaction mode or Session mode)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# If omitted during local testing, an embedded PostgreSQL WASM engine (PGlite) is used automatically.
DATABASE_URL=

# Optional: Upstash Redis for distributed rate limiting (Level 5)
# If omitted, server-side distributed rate limiting is handled atomically via PostgreSQL rate_limits table.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
